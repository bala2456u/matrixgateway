# Railway environment variables for matrixgateway
# Set these in Railway → your service → Variables. Never commit real values.

# Provided automatically by Railway's PostgreSQL plugin — reference it, don't hardcode:
DATABASE_URL="${{Postgres.DATABASE_URL}}"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="CHANGE_ME_LONG_RANDOM_STRING"

# Site-wide private preview gate. Unset this to open the site publicly
# (only do that once INR payouts are real).
ACCESS_CODE="CHANGE_ME_SHARED_CODE"

GATEWAY_MODE="sandbox"

# IMPORTANT: leave EMPTY on a public deployment. Any network listed here accepts
# REAL crypto, and payouts are still simulated — a stranger would lose money.
LIVE_NETWORKS=""

DEPOSIT_WINDOW_MINUTES="15"
SANDBOX_AUTO_PAY_SECONDS="18"

PLATFORM_FEE_BPS="50"
TDS_BPS="100"

# Optional RPC overrides (only used when LIVE_NETWORKS is non-empty)
# BSC_RPC_URL="https://bsc-rpc.publicnode.com"
# TRONGRID_URL="https://api.trongrid.io"

# Seeded admin password — set before first deploy, then change it after logging in
SEED_ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
