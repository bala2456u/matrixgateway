generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
}

enum OrderStatus {
  QUOTE
  AWAITING_DEPOSIT
  DEPOSIT_DETECTED
  DEPOSIT_CONFIRMED
  PAYOUT_PROCESSING
  COMPLETED
  EXPIRED
  FAILED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

/// Merchant payment lifecycle (mirrors the industry-standard gateway model).
enum PaymentStatus {
  WAITING        // created, awaiting the customer's transfer
  CONFIRMING     // seen on-chain, accumulating confirmations
  CONFIRMED      // enough confirmations
  SENDING        // crediting the merchant
  PARTIALLY_PAID // customer underpaid
  FINISHED       // complete
  FAILED
  REFUNDED
  EXPIRED
}

enum LedgerType {
  PAYMENT_CREDIT
  SERVICE_FEE
  PAYOUT_DEBIT
  ADJUSTMENT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  phone        String?
  role         Role     @default(CUSTOMER)
  kycStatus    KycStatus @default(NOT_SUBMITTED)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Merchant profile
  businessName String?
  ipnSecret    String?  // HMAC-SHA512 secret for IPN callbacks
  brandColor   String?  @default("#10b981")

  kycProfile   KycProfile?
  bankAccounts BankAccount[]
  orders       SellOrder[]
  apiKeys      ApiKey[]
  webhooks     WebhookEndpoint[]
  auditLogs    AuditLog[]
  payments     Payment[]
  invoices     Invoice[]
  ledger       LedgerEntry[]
}

/// A hosted payment link. Spawns a Payment when the customer opens it.
model Invoice {
  id              String   @id @default(cuid())
  token           String   @unique // public id used in the hosted URL
  merchantId      String
  merchant        User     @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  priceAmount     Decimal  @db.Decimal(18, 2)
  priceCurrency   String   @default("INR")
  payCurrency     String   @default("USDT")

  orderId         String?
  orderDescription String?
  ipnCallbackUrl  String?
  successUrl      String?
  cancelUrl       String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  payments        Payment[]

  @@index([merchantId, createdAt])
}

/// A single deposit intent: customer sends USDT to payAddress.
model Payment {
  id              String        @id @default(cuid())
  paymentId       String        @unique // public numeric id, gateway-style
  merchantId      String
  merchant        User          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  invoiceId       String?
  invoice         Invoice?      @relation(fields: [invoiceId], references: [id])

  priceAmount     Decimal       @db.Decimal(18, 2)
  priceCurrency   String        @default("INR")
  payCurrency     String        @default("USDT")
  payAmount       Decimal       @db.Decimal(28, 10)
  actuallyPaid    Decimal       @default(0) @db.Decimal(28, 10)
  lockedRateInr   Decimal       @db.Decimal(18, 4)

  networkId       String
  network         AssetNetwork  @relation(fields: [networkId], references: [id])
  payAddress      String

  serviceFee      Decimal       @default(0) @db.Decimal(28, 10) // in USDT
  outcomeAmount   Decimal       @default(0) @db.Decimal(28, 10) // credited to merchant

  status          PaymentStatus @default(WAITING)
  txHash          String?
  confirmations   Int           @default(0)

  orderId         String?
  orderDescription String?
  purchaseId      String?
  ipnCallbackUrl  String?
  successUrl      String?
  cancelUrl       String?

  createdViaApiKeyId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  expiresAt       DateTime
  paidAt          DateTime?

  events          PaymentEvent[]
  ledger          LedgerEntry[]
  ipnDeliveries   IpnDelivery[]

  @@index([merchantId, createdAt])
  @@index([status])
  @@index([txHash])
}

model IpnDelivery {
  id          String    @id @default(cuid())
  paymentId   String
  payment     Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  url         String
  eventType   String
  payload     Json
  statusCode  Int?
  success     Boolean   @default(false)
  attempts    Int       @default(0)
  lastAttempt DateTime?
  createdAt   DateTime  @default(now())

  @@index([success, attempts])
  @@index([paymentId, createdAt])
}

model PaymentEvent {
  id        String        @id @default(cuid())
  paymentId String
  payment   Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  status    PaymentStatus
  message   String
  createdAt DateTime      @default(now())

  @@index([paymentId, createdAt])
}

/// Double-entry-ish ledger of merchant USDT balance movements.
model LedgerEntry {
  id         String     @id @default(cuid())
  merchantId String
  merchant   User       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  paymentId  String?
  payment    Payment?   @relation(fields: [paymentId], references: [id])
  type       LedgerType
  amount     Decimal    @db.Decimal(28, 10) // signed, USDT
  note       String?
  createdAt  DateTime   @default(now())

  @@index([merchantId, createdAt])
}

/// Admin-editable platform configuration.
model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model KycProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  panNumber     String
  aadhaarLast4  String
  dateOfBirth   DateTime
  addressLine   String
  city          String
  state         String
  pincode       String
  status        KycStatus @default(PENDING)
  rejectReason  String?
  reviewedAt    DateTime?
  submittedAt   DateTime  @default(now())
}

model BankAccount {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountHolder String
  accountNumber String
  ifsc          String
  bankName      String
  upiId         String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())

  payouts       Payout[]
}

model Asset {
  id           String  @id @default(cuid())
  symbol       String  @unique // USDT, BTC, ETH, SOL
  name         String
  coingeckoId  String
  decimals     Int     @default(8)
  minSellAmount Decimal @db.Decimal(28, 10)
  sortOrder    Int     @default(100) // USDT first
  featured     Boolean @default(false)
  enabled      Boolean @default(true)

  networks     AssetNetwork[]
  orders       SellOrder[]
}

model AssetNetwork {
  id           String  @id @default(cuid())
  assetId      String
  asset        Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  code         String  // TRC20, BEP20, ERC20, SOL, BTC
  name         String  // "Tron (TRC-20)", "BNB Smart Chain (BEP-20)", ...
  addressFamily String // TRON | EVM | SOLANA | BITCOIN — controls address/tx formats
  confirmationsRequired Int @default(2)
  avgSettleMinutes Int  @default(2) // shown to customers as an ETA
  feeNote      String? // e.g. "Lowest fees — recommended"
  depositAddress String? // admin-fixed gateway wallet; all orders on this network pay here
  recommended  Boolean @default(false)
  sortOrder    Int     @default(100)
  enabled      Boolean @default(true)

  orders       SellOrder[]
  payments     Payment[]

  @@unique([assetId, code])
}

model SellOrder {
  id              String      @id @default(cuid())
  reference       String      @unique // human-friendly e.g. RR-20260806-XXXXXX
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  assetId         String
  asset           Asset       @relation(fields: [assetId], references: [id])
  networkId       String?
  network         AssetNetwork? @relation(fields: [networkId], references: [id])

  cryptoAmount    Decimal     @db.Decimal(28, 10)
  lockedRateInr   Decimal     @db.Decimal(18, 2) // INR per 1 unit of asset at quote time
  grossInr        Decimal     @db.Decimal(18, 2)
  platformFeeInr  Decimal     @db.Decimal(18, 2)
  tdsInr          Decimal     @db.Decimal(18, 2) // 1% TDS u/s 194S
  netInr          Decimal     @db.Decimal(18, 2)

  status          OrderStatus @default(QUOTE)
  quoteExpiresAt  DateTime
  depositAddress  String?
  depositTxHash   String?
  depositBlockNumber Int?     // block of the real on-chain transfer (live networks)
  confirmations   Int         @default(0)
  failureReason   String?

  bankAccountId   String?
  payout          Payout?

  createdViaApiKeyId String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  completedAt     DateTime?

  events          OrderEvent[]

  @@index([userId, createdAt])
  @@index([status])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     SellOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  message   String
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model Payout {
  id            String       @id @default(cuid())
  orderId       String       @unique
  order         SellOrder    @relation(fields: [orderId], references: [id])
  bankAccountId String
  bankAccount   BankAccount  @relation(fields: [bankAccountId], references: [id])
  amountInr     Decimal      @db.Decimal(18, 2)
  mode          String       @default("IMPS") // IMPS | NEFT | UPI
  utr           String?      // bank reference number
  status        PayoutStatus @default(PENDING)
  failureReason String?
  createdAt     DateTime     @default(now())
  settledAt     DateTime?
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String
  prefix     String    @unique // rr_live_xxxx (first 12 chars, shown in UI)
  keyHash    String    // sha256 of full key
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
}

model WebhookEndpoint {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url        String
  secret     String   // HMAC signing secret
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())

  deliveries WebhookDelivery[]
}

model WebhookDelivery {
  id           String   @id @default(cuid())
  endpointId   String
  endpoint     WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  eventType    String   // order.completed, order.deposit_confirmed, ...
  payload      Json
  statusCode   Int?
  success      Boolean  @default(false)
  attempts     Int      @default(0)
  lastAttempt  DateTime?
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // e.g. "user.login", "order.create", "kyc.approve"
  detail    String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
